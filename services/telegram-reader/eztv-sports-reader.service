[Unit]
Description=EZTV private Telegram sports reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eztv-sports-reader
Group=eztv-sports-reader
EnvironmentFile=/etc/eztv-sports-reader.env
ExecStart=/opt/eztv-sports-reader/venv/bin/python /opt/eztv-sports-reader/reader.py
Restart=always
RestartSec=15
StateDirectory=eztv-sports-reader
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
