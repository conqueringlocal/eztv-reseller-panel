[Unit]
Description=EZTV independent sports schedule verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=eztv-sports-reader
Group=eztv-sports-reader
EnvironmentFile=/etc/eztv-sports-reader.env
ExecStart=/opt/eztv-sports-reader/venv/bin/python /opt/eztv-sports-reader/verifier.py
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
